{
  "name": "cal01-monitor-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "CAL01 팀 관제 Windows 앱",
  "author": "posco-3bungi-pdm",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test *.test.cjs",
    "build": "node build.cjs"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "org.posco3bungipdm.cal01monitor",
    "productName": "CAL01 Monitor",
    "directories": { "output": "dist" },
    "files": ["main.cjs", "preload.cjs", "server-url.cjs", "settings/**", "package.json"],
    "win": { "target": ["portable"], "signExecutable": false },
    "portable": { "artifactName": "CAL01-Monitor-${version}-win-x64.exe" }
  }
}
